# Anthropic API key (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Figma MCP server endpoint.
#   Desktop app (Preferences > Enable Dev Mode MCP server): http://127.0.0.1:3845/mcp
#   Remote server:                                          https://mcp.figma.com/mcp
FIGMA_MCP_URL=http://127.0.0.1:3845/mcp

# Bearer token for the Figma MCP server (needed for the remote server; leave
# empty for the desktop server).
FIGMA_MCP_TOKEN=

# Optional: comma-separated allowlist of Figma MCP tool names to expose to the agent.
# Empty = expose every tool the server offers.
FIGMA_TOOLS=

# Claude model and effort (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

PORT=3000
